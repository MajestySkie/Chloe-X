local Games = {
    ["Rivals"] = {
        Folder = "Rivals",
        GameId = 6035872082,
        Script = "https://flowauth.net/v1/loaders/632881ef47682831ac434d58cb875e90.lua",
    },
    ["BreakStealAndEgg"] = {
        Folder = "BreakStealAndEgg",
        GameId = 10765288803,
        Script = "https://flowauth.net/v1/loaders/8b701036a55d4b363b17c25ee1c79242.lua",
    },
    ["Universal"] = {
        Folder = "Universal",
        Script = "https://flowauth.net/v1/loaders/5986e494fa0ec3a28e374ca7d9239dd4.lua",
    },
}

if getgenv and getgenv().ChloeX_Running then
    return Games
end

local currentGameId = game.GameId
local currentPlaceId = game.PlaceId
local targetGame = nil

for _, data in pairs(Games) do
    if data.GameId == currentGameId or (type(data.GameId) == "table" and table.find(data.GameId, currentGameId)) then
        targetGame = data
        break
    elseif data.PlaceId == currentPlaceId or (type(data.PlaceId) == "table" and table.find(data.PlaceId, currentPlaceId)) then
        targetGame = data
        break
    end
end

if not targetGame then
    targetGame = Games["Universal"]
end

if targetGame and targetGame.Script and targetGame.Script ~= "" then
    local success, scriptContent = pcall(function()
        return game:HttpGet(targetGame.Script)
    end)

    local isValidBody = success
        and type(scriptContent) == "string"
        and scriptContent ~= ""
        and not string.find(scriptContent, "^40" .. "4")
        and not string.find(scriptContent, "40" .. "4: Not Found")
        and not string.find(scriptContent, "^%s*<")

    if isValidBody then
        local chunk, compileErr = loadstring(scriptContent)
        if chunk then
            chunk()
        else
            warn("Failed to compile loader:", compileErr)
        end
    else
        warn("Failed to fetch loader!")
    end
end

return Games
